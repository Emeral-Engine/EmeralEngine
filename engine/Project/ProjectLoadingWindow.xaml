<Window x:Class="EmeralEngine.Project.ProjectLoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmeralEngine.Project"
        mc:Ignorable="d"
        Title="プロジェクトの読み込み中" Height="170" Width="380" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Name="Description" Content="プロジェクトを読み込み中..." Foreground="Black" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <ProgressBar Name="Progress" Grid.Row="1" Height="20" Minimum="0" Maximum="100" Value="0"/>
        <Label Name="Percent" Grid.Row="2" Content="0%" Foreground="Black" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
